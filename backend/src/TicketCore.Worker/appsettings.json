{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Urls": "http://localhost:5231",
  "ConnectionStrings": {
    "Database": ""
  },
  "App": {
    "PublicUrl": "http://localhost:5173",
    "ProductName": "VueTicket"
  },
  "Engine": {
    "Events": { "Enabled": true, "IntervalSeconds": 5 },
    "SlaMonitor": { "Enabled": true, "IntervalSeconds": 30 },
    "Escalation": { "Enabled": true, "IntervalSeconds": 60 },
    "Assignment": { "Enabled": true, "IntervalSeconds": 30 },
    "UnassignedWatch": { "Enabled": true, "IntervalSeconds": 60 },
    "AutoClose": { "Enabled": true, "IntervalSeconds": 300 },
    "LogCleanup": { "Enabled": true, "IntervalSeconds": 3600 },
    "RunLogRetentionDays": 30,
    "ReferenceDataRefreshSeconds": 120
  },
  "Storage": {
    "LocalPath": "App_Data/files"
  },
  "Email": {
    "Mode": "Pickup",
    "PickupPath": "App_Data/mail",
    "FromAddress": "support@acme.local",
    "FromName": "VueTicket Support",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpStartTls": true,
    "DispatcherEnabled": true
  }
}
