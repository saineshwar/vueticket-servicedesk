<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwConfigExceptions="true">

  <extensions>
    <add assembly="NLog.Web.AspNetCore" />
  </extensions>

  <targets>
    <target xsi:type="File" name="file"
            fileName="${basedir}/logs/vueticket-engine-${shortdate}.log"
            archiveAboveSize="20000000" maxArchiveFiles="30"
            layout="${longdate}|${level:uppercase=true}|${logger}|${aspnet-request-method} ${aspnet-request-url}|${message} ${exception:format=tostring}" />
    <target xsi:type="Console" name="console"
            layout="${time}|${level:uppercase=true:padding=-5}|${logger:shortName=true}|${message} ${exception:format=shortType,message}" />
  </targets>

  <rules>
    <logger name="Microsoft.*" maxlevel="Info" final="true" />
    <logger name="System.Net.Http.*" maxlevel="Info" final="true" />
    <logger name="*" minlevel="Info" writeTo="file,console" />
  </rules>
</nlog>
