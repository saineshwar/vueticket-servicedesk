{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Database": ""
  },
  "Jwt": {
    "Issuer": "VueTicket",
    "Audience": "VueTicket",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Security": {
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15
  },
  "App": {
    "PublicUrl": "http://localhost:5173",
    "ProductName": "VueTicket"
  },
  "Storage": {
    "LocalPath": "App_Data/files",
    "MaxFileBytes": 10485760,
    "MaxFilesPerUpload": 5
  },
  "Email": {
    "Mode": "Pickup",
    "PickupPath": "App_Data/mail",
    "FromAddress": "support@acme.local",
    "FromName": "VueTicket Support",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpStartTls": true,
    "DispatcherEnabled": false
  }
}
